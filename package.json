{
  "name": "kosh",
  "version": "0.0.0",
  "private": true,
  "description": "Kosh: open-source investment tracker for Indian investors. Every investment. One ledger.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @kosh/web dev",
    "dev:all": "concurrently -k -n emu,web -c yellow,cyan \"pnpm emulators\" \"pnpm dev\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-kosh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kosh \"pnpm --filter @kosh/firebase test:emulator\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke-api.mjs",
    "seed": "node scripts/seed-demo.mjs",
    "cron": "node scripts/run-cron.mjs",
    "check-env": "node scripts/check-env.mjs",
    "admin:grant": "pnpm --filter @kosh/web exec node scripts/grant-admin.mjs",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "firebase-tools": "15.35.0",
    "prettier": "^3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
