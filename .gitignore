# dependencies
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# env & secrets: never commit real values
.env
.env.*
!apps/web/.env.development
!.env.example
*.pem
service-account*.json

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
firebase/emulator-data/

# real broker / CAS statements must never be committed
# Spreadsheets and PDFs are ignored everywhere; only REDACTED fixtures are allowed back in.
*.xls
*.xlsx
*.xlsm
*.xlsb
*.ods
*.pdf
!packages/parsers/fixtures/**/*.xls
!packages/parsers/fixtures/**/*.xlsx
!packages/parsers/fixtures/**/*.pdf
# broker export file names, whatever the extension (Groww, INDmoney)
*Holdings_Statement_*
*HOLDINGS_REPORT*
# anything uploaded or dropped in for local testing
uploads/
packages/parsers/fixtures/_incoming/

# tests
# test coverage output only at package roots (BUG-011: a bare coverage/ hid an API route)
/coverage/
/apps/*/coverage/
/packages/*/coverage/
playwright-report/
test-results/
# end-to-end recordings (videos) stay local: never committed
/artifacts/

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# local tool config (machine-specific paths)
.claude/launch.json
.claude/settings.local.json

# your own Firebase project alias (copy .firebaserc.example); emulators use --project demo-kosh
.firebaserc
