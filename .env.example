# Kosh environment variables — bring your own Firebase project and FREE keys.
# ---------------------------------------------------------------------------------------------
# Local development needs NONE of these: apps/web/.env.development already points at the
# Firebase emulators (offline "demo-kosh" project, no account needed).
#
# For a real deployment: copy to apps/web/.env.local (local prod test) or set them in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
#
# Legend:  [REQUIRED] / [OPTIONAL]   ·   PUBLIC = shipped to browsers (NEXT_PUBLIC_*)
#          SERVER = server-only, never exposed to the browser
# Every external service Kosh uses works on a FREE tier or with no key. Nothing is paid.
# Check your setup:  pnpm check-env

# --- Firebase web app (Firebase console → Project settings → Your apps → Web app) -----------
# PUBLIC by design (they identify the project, they are not secrets). Restrict the API key to
# your domains: Google Cloud console → APIs & Services → Credentials → the "Browser key".
NEXT_PUBLIC_FIREBASE_API_KEY=                 # [REQUIRED] PUBLIC
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=             # [REQUIRED] PUBLIC  <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=              # [REQUIRED] PUBLIC  your project id
NEXT_PUBLIC_USE_EMULATORS=false               # [OPTIONAL] PUBLIC  true ONLY for local emulators

# --- Firebase Admin SDK (Project settings → Service accounts → Generate new private key) ----
# SERVER. Base64 of the downloaded JSON (keep the file out of the repo; delete it after).
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   macOS/Linux: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=         # [REQUIRED in production] SERVER
# Emulators only (refused on Vercel production — they make the server accept unsigned tokens):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080      # [LOCAL ONLY] SERVER
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099  # [LOCAL ONLY] SERVER

# --- App --------------------------------------------------------------------------------------
APP_BASE_URL=https://kosh.example.com         # [REQUIRED] SERVER  your public URL (no trailing /)
CRON_SECRET=                                  # [REQUIRED in production] SERVER  long random value;
                                              # Vercel cron sends it to /api/cron/* automatically.
                                              # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Prices (only instrument symbols are ever sent) -------------------------------------------
# Yahoo Finance UNOFFICIAL endpoint, no key. ON by default; prices NSE, BSE (fallback) and US.
# Not an official API: may change or stop; its terms may not permit this use. You decide.
ENABLE_UNOFFICIAL_YAHOO=true                  # [OPTIONAL] SERVER  set false to disable
# Alpha Vantage FREE key (alphavantage.co/support/#api-key), used ONLY for BSE stocks.
ALPHAVANTAGE_API_KEY=                         # [OPTIONAL] SERVER  free key
ALPHAVANTAGE_DAILY_LIMIT=25                   # [OPTIONAL] SERVER  free-tier daily calls (shared by all users)
# ALPHAVANTAGE_MIN_INTERVAL_MS=12500          # [OPTIONAL] SERVER  gap between calls (≤5/min)
# Optional FREE keys for US stocks (tried before Yahoo when set):
FINNHUB_API_KEY=                              # [OPTIONAL] SERVER  free key (finnhub.io)
TWELVEDATA_API_KEY=                           # [OPTIONAL] SERVER  free key (twelvedata.com)
# Mutual funds (AMFI), crypto (CoinDCX) and USD/INR (Frankfurter/ECB) need no key.

# --- Not used yet (later milestones) ----------------------------------------------------------
# TOKEN_ENC_KEYS={"k1":"<32-byte base64>"}    # [M4] SERVER  broker-token encryption keys
# TOKEN_ENC_ACTIVE=k1                         # [M4] SERVER
# HMAC_PEPPER=                                # [M4] SERVER
# OAUTH_SIGNING_SECRET=                       # [M8] SERVER  MCP OAuth
# RESEND_API_KEY=                             # [M7] SERVER  free tier (3,000/month)
# EMAIL_FROM="Kosh <reports@example.com>"     # [M7] SERVER
# EMAIL_DAILY_CAP=90                          # [M7] SERVER
# GRIEVANCE_EMAIL=                            # [M9] SERVER  DPDP grievance contact
