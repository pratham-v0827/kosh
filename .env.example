# Kosh environment variables
# ---------------------------------------------------------------------------------------------
# Local development needs NONE of these: apps/web/.env.development points at the Firebase
# emulators (offline "demo-kosh" project). Copy this file to apps/web/.env.local for real values.
# NEVER commit real values. Variables marked [later] are used from the milestone noted.

# --- Firebase web config (public by design; restrict the API key by HTTP referrer) -----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=            # <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=             # e.g. kosh-prod
NEXT_PUBLIC_USE_EMULATORS=false              # true only for local development

# --- Firebase Admin SDK (server only) -------------------------------------------------------
# Base64 of the service-account JSON. PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Set these two ONLY when talking to the emulators:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- App ------------------------------------------------------------------------------------
APP_BASE_URL=https://kosh.example.com        # public URL; used for OAuth issuer and email links
CRON_SECRET=                                 # bearer secret for /api/cron/* (Vercel sends it automatically); long random value

# --- Encryption & signing (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TOKEN_ENC_KEYS={"k1":"<32-byte base64>"}     # [M4] broker-token AES-256-GCM keys, JSON map keyId→key
TOKEN_ENC_ACTIVE=k1                          # [M4] key id used for new encryptions
HMAC_PEPPER=                                 # [M4] hashes broker user IDs and unsubscribe tokens
OAUTH_SIGNING_SECRET=                        # [M8] MCP OAuth state/consent signing

# --- Price providers (symbols only are ever sent) --------------------------------------------
FINNHUB_API_KEY=                             # [M2] US quotes, free tier
TWELVEDATA_API_KEY=                          # [M2] optional US fallback
ENABLE_UNOFFICIAL_YAHOO=false                # [M2] keep false; see docs before enabling

# --- Email ----------------------------------------------------------------------------------
RESEND_API_KEY=                              # [M7] leave empty to disable emails
EMAIL_FROM="Kosh <reports@kosh.example.com>" # [M7]
EMAIL_DAILY_CAP=90                           # [M7] stay under the provider's free daily limit

# --- Compliance -----------------------------------------------------------------------------
GRIEVANCE_EMAIL=                             # [M9] DPDP grievance contact shown in the privacy policy
