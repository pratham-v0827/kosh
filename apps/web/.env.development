# Local development against the Firebase emulators (offline "demo-" project).
# Contains NO secrets, so it is committed. Real values go in .env.local (git-ignored).
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-kosh
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-kosh.firebaseapp.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
APP_BASE_URL=http://localhost:3000
# Local-only secret for the daily job (/api/cron/daily). Production must set its own random value.
CRON_SECRET=local-dev-cron-secret
